DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority"

# Used only by `npm run seed:superadmin` to create/reset the first superadmin account.
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="change-me-please"

# Base URL used to build the links inside verification emails (no trailing slash).
APP_URL="http://localhost:3000"

# SMTP settings used to send account-verification emails. Required for self-registration to work.
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="user@example.com"
EMAIL_PASS="change-me"
EMAIL_FROM="VR Instant Fill <no-reply@example.com>"
